# ── Binaries committed by mistake ────────────────────────────────────────────
# Root-anchored: an unanchored `bin/` also matches `crates/*/src/bin/`, which is
# the standard Cargo layout for additional binaries, and would silently drop them.
/bin/
*.bin

# ── Contract ABIs and build artifacts (Hardhat) ──────────────────────────────
artifacts/
cache/

# ── Benchmarks and profiling output ──────────────────────────────────────────
perf.data
perf.data.old
